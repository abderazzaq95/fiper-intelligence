# ─── server ───────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:5173,https://intelligence.fiper.me,https://www.intelligence.fiper.me

# ─── keyless providers (work with no configuration) ───────
# Binance      crypto spot prices + OHLC
# Frankfurter  ECB reference FX rates
# CFTC         Commitments of Traders positioning
# Nothing to set — these are enabled by default.

# ─── keyed providers (each degrades to null if unset) ─────
# Indices, commodities, equities. https://twelvedata.com (800 req/day free)
TWELVEDATA_KEY=

# Headlines. https://marketaux.com (100 req/day free) or https://finnhub.io
MARKETAUX_KEY=
FINNHUB_KEY=

# Economic calendar. https://site.financialmodelingprep.com or https://tradingeconomics.com
FMP_KEY=
TRADING_ECONOMICS_KEY=

# ─── AI interpretation layer ──────────────────────────────
# Turns a raw headline into per-asset directional impact.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── refresh cadence (ms) ─────────────────────────────────
REFRESH_FAST=15000
REFRESH_SLOW=300000
REFRESH_DAILY=3600000
REFRESH_BROKER=20000
TRADE_EVAL_INTERVAL=300000

# ─── "Trade for Me" — paper-trading auto-execution (Capital.com demo account) ───
# Sign up free at capital.com for a demo account, then Settings > API
# integrations > Generate new key (2FA required). CAPITAL_IDENTIFIER is
# your login email; CAPITAL_PASSWORD is the custom API-key password you
# set when generating the key (not necessarily your account password).
# Demo environment only — there is no live-trading code path in this app.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
TRADE_ENABLED=false           # master switch — stays off until you explicitly enable it via the UI or POST /api/trade/settings
TRADE_MAX_RISK_PCT=1          # % of account balance risked per trade
TRADE_MAX_DAILY_LOSS_PCT=3    # daily realized-loss circuit breaker — trips the kill switch automatically
TRADE_MAX_OPEN_POSITIONS=3
TRADE_MIN_CONFIDENCE=70       # bias engine confidence floor before a signal is actionable
TRADE_ALLOWED_INSTRUMENTS=XAUUSD,EURUSD,GBPUSD
TRADE_API_SECRET=             # required as x-trade-secret header on POST /api/trade/* once set — recommended if this backend is ever reachable beyond localhost
