# ─── server ───────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:5173,https://intelligence.fiper.me,https://www.intelligence.fiper.me

# ─── keyless providers (work with no configuration) ───────
# Binance      crypto spot prices + OHLC
# Frankfurter  ECB reference FX rates
# CFTC         Commitments of Traders positioning
# Nothing to set — these are enabled by default.

# ─── keyed providers (each degrades to null if unset) ─────
# Indices, commodities, equities. https://twelvedata.com (800 req/day free)
TWELVEDATA_KEY=

# Headlines. https://marketaux.com (100 req/day free) or https://finnhub.io
MARKETAUX_KEY=
FINNHUB_KEY=

# Economic calendar. https://site.financialmodelingprep.com or https://tradingeconomics.com
FMP_KEY=
TRADING_ECONOMICS_KEY=

# ─── AI interpretation layer ──────────────────────────────
# Turns a raw headline into per-asset directional impact.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── refresh cadence (ms) ─────────────────────────────────
REFRESH_FAST=15000
REFRESH_SLOW=300000
REFRESH_DAILY=3600000
