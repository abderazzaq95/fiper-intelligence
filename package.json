{
  "name": "fiper-backend",
  "version": "0.1.0",
  "description": "Market intelligence API — aggregates, caches and interprets market data for the Fiper terminal",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "status": "node --input-type=module -e \"const r=await fetch('http://localhost:8080/api/status');console.log(JSON.stringify(await r.json(),null,2))\"",
    "research": "node --use-system-ca scripts/research.js",
    "diagnose": "node --use-system-ca scripts/diagnose.js",
    "signals": "node --use-system-ca scripts/signals.js",
    "telegram": "node --use-system-ca scripts/telegram.js",
    "replay": "node --use-system-ca scripts/replay.js",
    "gold:pull": "node scripts/gold/pull.js",
    "gold:research": "node --max-old-space-size=4096 scripts/gold/research.js",
    "gold:flip": "node --max-old-space-size=4096 scripts/gold/flip-research.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ws": "^8.18.0"
  }
}
